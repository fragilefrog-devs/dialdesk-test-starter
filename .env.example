# ── App ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_EMAILS=you@example.com

# ── Supabase ────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Local Ollama model ──────────────────────────────
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=gemma3:1b

# ── Stripe ──────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=

# ── Telephony (Twilio) ──────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ── Voice gateway (separate WebSocket service) ──────
# Public wss:// URL Twilio streams audio to
VOICE_GATEWAY_URL=wss://voice.example.com/twilio
# Optional explicit website WebSocket URL; otherwise derived by replacing /twilio with /web
VOICE_GATEWAY_WEB_URL=wss://voice.example.com/web
# Shared secret: gateway <-> Next.js tool/usage endpoints (openssl rand -hex 32)
INTERNAL_API_SECRET=
# Gateway runtime: Whisper.cpp and Piper binaries/models must exist on the gateway host
APP_URL=http://localhost:3000
WHISPER_CPP_PATH=pwcpp
WHISPER_MODEL_PATH=
PIPER_PATH=piper
PIPER_MODEL_PATH=

# ── Email (Resend) ──────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Receptionist <hello@example.com>"
