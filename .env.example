# ── App ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_EMAILS=you@example.com

# ── Supabase ────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Vapi (voice runtime: telephony, speech, LLM) ────
VAPI_API_KEY=
# Shared secret Vapi sends with every server message (openssl rand -hex 32).
VAPI_WEBHOOK_SECRET=
# Optional: id of a Vapi custom credential (Bearer token = the secret above). Preferred over the inline secret.
VAPI_SERVER_CREDENTIAL_ID=
# Optional overrides; defaults shown. Pick by listening to real test calls.
VAPI_MODEL_PROVIDER=openai
VAPI_MODEL=gpt-4o
VAPI_VOICE_PROVIDER=openai
VAPI_TRANSCRIBER_PROVIDER=deepgram
VAPI_TRANSCRIBER_MODEL=nova-2

# ── Stripe ──────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=

# ── SMS alerts (optional; without these, alerts go by email only) ──
# Needs a registered US sender (A2P 10DLC or toll-free verification).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=

# ── Email (Resend) ──────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="DialDesk <hello@example.com>"
